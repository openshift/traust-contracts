{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/traust-contracts/schemas/v1/budget-policy.schema.json",
  "title": "Budget Policy",
  "description": "Schema for config/budget-policy.yaml \u2014 spend governance for harness runs (policy artifact; enforcement staged). Permissive by design: the many placeholder budget blocks are deployment-specific; only the nested budget_policy container and its enforcement posture are validated.",
  "type": "object",
  "required": [
    "budget_policy"
  ],
  "additionalProperties": true,
  "properties": {
    "budget_policy": {
      "type": "object",
      "required": [
        "version",
        "enforcement"
      ],
      "additionalProperties": true,
      "properties": {
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "enforcement": {
          "type": "string",
          "enum": [
            "none",
            "observe",
            "advisory",
            "enforced"
          ]
        }
      }
    }
  }
}
